# Copy to .env for local development. Never commit real values.
# Settings are validated at startup (app/core/config.py).

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated allowlist (no "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. Vercel previews
CORS_ORIGIN_REGEX=
SITE_URL=http://localhost:5173
# Where Paystack sends the customer after paying (web page or mobile deep-link bridge)
PAYMENT_CALLBACK_URL=http://localhost:5173/checkout/callback

# Supabase (`supabase start` prints these for the local stack)
SUPABASE_URL=http://127.0.0.1:54321
# Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Legacy HS256 secret, only if the project still signs tokens with it
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Staging/production: the Supabase transaction pooler, port 6543
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_SIZE=5

REDIS_URL=redis://127.0.0.1:6379/0

# sk_test_... everywhere except production (enforced at startup)
PAYSTACK_SECRET_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# us | eu
MAILGUN_REGION=us
STORE_NOTIFICATION_EMAIL=

SENTRY_DSN=
# When set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
PAYMENT_PENDING_TTL_MINUTES=60
RECONCILE_INTERVAL_MINUTES=5
# Free-tier staging only: run the arq worker inside the API process (refused in production)
RUN_WORKER_IN_PROCESS=false
