                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Categories",
        "tags": [
          "catalog"
        ]
      }
    },
    "/v1/catalog/products": {
      "get": {
        "operationId": "list_products_v1_catalog_products_get",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "bundles",
                    "wigs",
                    "frontals",
                    "care"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "texture",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 60,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Texture"
            }
          },
          {
            "description": "Exact length in inches",
            "in": "query",
            "name": "length",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact length in inches",
              "title": "Length"
            }
          },
          {
            "description": "Storefront buckets: 16 = 14-18in, 20 = 20-24, 26 = 26-30, 32 = 32+",
            "in": "query",
            "name": "length_range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "16",
                    "20",
                    "26",
                    "32"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Storefront buckets: 16 = 14-18in, 20 = 20-24, 26 = 26-30, 32 = 32+",
              "title": "Length Range"
            }
          },
          {
            "in": "query",
            "name": "min_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
